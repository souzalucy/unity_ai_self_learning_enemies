<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the runtime assembly (Core + Actions + Observations + Rewards)
    into SelfLearningEnemies.dll. The Editor folder is intentionally excluded.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SelfLearningEnemies</AssemblyName>
    <RootNamespace>SelfLearningEnemies</RootNamespace>
  </PropertyGroup>

  <!-- UnityEngine modules used by the runtime code -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.VehiclesModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.VehiclesModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityManaged)/UnityEngine/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ML-Agents assemblies (generated by Unity, see Directory.Build.props) -->
  <ItemGroup>
    <Reference Include="Unity.ML-Agents">
      <HintPath>$(UnityProject)/Library/ScriptAssemblies/Unity.ML-Agents.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ML-Agents.CommunicatorObjects">
      <HintPath>$(UnityProject)/Library/ScriptAssemblies/Unity.ML-Agents.CommunicatorObjects.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Runtime source only -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../Core/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Actions/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Observations/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Rewards/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Minigames/**/*.cs" />
  </ItemGroup>

</Project>
